# ============================================================
# Backend (FastAPI) environment variables
# Copy to backend/.env and fill in the real values.
# ============================================================

# ---------- Database: Supabase PostgreSQL (Transaction Pooler, port 6543) ----------
# Get this from: Supabase Dashboard > Connect > "Transaction pooler" (port 6543).
# Replace [YOUR-PASSWORD] with your database password.
# The project ref for Blueseatra is: xmsxlochasjauhnxarvc
# Region: West EU (Ireland) = eu-west-1
#
# Format (Transaction Pooler):
#   postgresql+asyncpg://postgres.xmsxlochasjauhnxarvc:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Schema holding the Blueseatra tables (created via migration).
# Leave as 'blueseatra' unless you move the tables.
DB_SCHEMA=blueseatra

# ---------- Supabase API ----------
SUPABASE_URL=https://xmsxlochasjauhnxarvc.supabase.co

# Publishable / anon key (safe for clients).
SUPABASE_ANON_KEY=

# Service role key (FULL ACCESS — server-side ONLY, never expose to the browser).
# Get it from: Supabase Dashboard > Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- App secrets ----------
# Secret used to sign the app's own JWT.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

# Fernet key to encrypt tenant AI keys at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# ---------- Hermes AI / Ollama (OVH VPS) — default AI engine since July 2026 ----------
# URL of the Ollama instance (Caddy on OVH, never raw :11434 in production).
# Local: http://localhost:11434
# Prod : https://ia.blueseatra.com   (repo privé zehair-louzza/ovh-ai-stack)
HERMES_BASE_URL=http://localhost:11434

# Ollama model. Official name is hermes3 ; alias hermes-3 is created on the VPS.
HERMES_DEFAULT_MODEL=hermes-3

# Same value as OLLAMA_API_KEY in ovh-ai-stack/.env (sent as X-Api-Key).
# Leave empty only for a local unauthenticated Ollama.
HERMES_API_KEY=

# ---------- Optional fallback cloud providers (configurable per-tenant in Settings) ----------
# These are NOT required if you use Hermes/Ollama as default.
# Tenants can configure their own keys via the Integrations settings page.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ---------- Upload & CORS ----------
# Max upload size in bytes (default: 15 MB)
# MAX_UPLOAD_SIZE=15728640

# Comma-separated list of allowed origins (e.g. https://blueseatra.com)
# CORS_ORIGINS=http://localhost:3000

# ---------- Legacy MongoDB (only needed to run the one-time data migration) ----------
# Leave empty once migration is complete.
MONGO_URL=
DB_NAME=

# ---------- REMOVED variables ----------
# EMERGENT_LLM_KEY — removed in July 2026 (Emergent provider deprecated).
# Do NOT add this variable — it is no longer used by any module.
