# Exemple de configuration de l'API Blueseatra. Copier en .env et compléter.
# Ne JAMAIS committer le fichier .env. Détail : docs/guide-developpeur.md

# Base PostgreSQL (Supabase : Transaction Pooler, port 6543)
DATABASE_URL=postgresql+asyncpg://postgres:motdepasse@localhost:5432/blueseatra
# Rôle non propriétaire soumis à la RLS (recommandé, obligatoire en production)
DATABASE_URL_APP=
DB_SCHEMA=blueseatra

# Sécurité : générer avec les commandes du guide développeur
JWT_SECRET=
APP_ENCRYPTION_KEY=

# Moteur IA (Ollama local ou VPS OVH)
HERMES_BASE_URL=http://localhost:11434
HERMES_DEFAULT_MODEL=hermes-3
HERMES_API_KEY=

# Quotas : 0 = observation, 1 = blocage
BLUESEATRA_QUOTAS_APPLIQUES=0

# Divers
CORS_ORIGINS=http://localhost:3000
# REDIS_URL=redis://localhost:6379/0
# MAX_UPLOAD_SIZE=15728640
