# ============================================================
# Backend (FastAPI) environment variables
# Copy to backend/.env and fill in the real values.
# ============================================================

# ---------- Database: Supabase PostgreSQL (Transaction Pooler, port 6543) ----------
# Get this from: Supabase Dashboard (Blueseatra project) > Connect >
#   "Transaction pooler" (port 6543, NOT the direct 5432 connection).
# Replace [YOUR-PASSWORD] with your database password.
# The project ref for Blueseatra is: xmsxlochasjauhnxarvc
# The database region is West EU (Ireland) = eu-west-1.
#
# Format (Transaction Pooler):
#   postgresql://postgres.xmsxlochasjauhnxarvc:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Schema holding the Blueseatra tables (created via migration).
# Leave as 'blueseatra' unless you move the tables. The connection sets
# search_path to this schema automatically (see database.py).
DB_SCHEMA=blueseatra

# ---------- Supabase API (used by Supabase client / Storage / Auth, if needed) ----------
SUPABASE_URL=https://xmsxlochasjauhnxarvc.supabase.co

# Publishable / anon key (safe for clients). Server can also use it.
SUPABASE_ANON_KEY=

# Service role key (FULL ACCESS — server-side ONLY, never expose to the browser).
# Get it from: Supabase Dashboard > Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Legacy MongoDB (only needed to run the one-time data migration) ----------
# Leave empty once migration is done.
MONGO_URL=
DB_NAME=

# ---------- App secrets ----------
# Secret used to sign the app's own JWT (the 'bs_token').
JWT_SECRET=change-me-to-a-long-random-string

# AI provider key (see ai_service.py). Optional.
EMERGENT_LLM_KEY=
