# Blueseatra backend image — shared by the API and the extraction worker.
# Build context: REPOSITORY ROOT (see compose.yaml), because the backend
# sources live in backend/ and read their requirements from there.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    # Required for scripts mounted at /preprod-scripts (see compose.yaml):
    # they import backend modules (database, models_sql) by name.
    PYTHONPATH=/app/backend

RUN addgroup --system app && adduser --system --ingroup app app

WORKDIR /app/backend

# Dependencies first: this layer is cached across code changes.
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ ./

# backend/.env would be loaded by database.py via load_dotenv if present.
# It must NEVER exist inside the image: all configuration comes from the
# environment provided by docker compose (preprod) or the platform (Render).
RUN rm -f .env

USER app

EXPOSE 8000

# API entrypoint. The worker container overrides this with:
#   python extraction_worker.py
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000"]
