# ============================================================================
# Blueseatra preproduction environment (OVH VPS)
#
# Copy to .env.preprod, run `chmod 600 .env.preprod`, then replace EVERY
# placeholder. Never commit .env.preprod. Never reuse production secrets.
# scripts/validate-env.sh refuses placeholders and production-looking values.
# ============================================================================

# --- Infrastructure (docker compose) ----------------------------------------
POSTGRES_DB=blueseatra_preprod
POSTGRES_USER=blueseatra_preprod
POSTGRES_PASSWORD=replace-with-a-long-unique-postgres-password

# Password given to the restricted `blueseatra_app` role (business/RLS path).
# Set automatically on the role by scripts/migrate.sh after migrations pass.
PREPROD_APP_DB_PASSWORD=replace-with-a-long-unique-app-role-password

REDIS_PASSWORD=replace-with-a-long-unique-redis-password

MINIO_ROOT_USER=blueseatra-preprod
MINIO_ROOT_PASSWORD=replace-with-a-long-unique-minio-password

# Where the API listens on the VPS. Keep the default 127.0.0.1 binding and use
# an SSH tunnel or the existing reverse proxy; never expose it directly.
API_BIND=127.0.0.1:8080

# --- Application (passed to api/worker containers) ---------------------------
# Frontend origin allowed by CORS. Adjust if you proxy a preprod frontend.
CORS_ORIGINS=http://localhost:5173

# Long random secrets — generate with: openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32
APP_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32

# Hermes gateway (PREPRODUCTION instance). Point at a preprod Hermes with a
# test budget — never at the production gateway.
HERMES_BASE_URL=https://preprod-hermes.example.com
HERMES_API_KEY=replace-with-a-preprod-hermes-key

# Optional overrides — leave commented to use the backend defaults.
# HERMES_DEFAULT_MODEL=
# HERMES_OCR_MODEL=
# MAX_UPLOAD_SIZE=26214400
