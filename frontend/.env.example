# ============================================================
# Frontend (Create React App / CRACO) environment variables
# Copy this file to `.env` (or set vars in your host) BEFORE running `yarn build`.
# Only variables prefixed with REACT_APP_ are embedded in the browser bundle.
# ============================================================

# Base URL of the Blueseatra backend API (FastAPI).
# The client calls `${REACT_APP_BACKEND_URL}/api/...` (see src/lib/api.js).
# Examples:
#   Local dev:   REACT_APP_BACKEND_URL=http://localhost:8000
#   Production:  REACT_APP_BACKEND_URL=https://api.votredomaine.com
REACT_APP_BACKEND_URL=http://localhost:8000

# NOTE:
# The frontend does NOT talk to Supabase directly. All data goes through the
# backend API, which holds the Supabase/Postgres credentials. Do not put any
# Supabase service key in the frontend — it would be exposed in the bundle.
